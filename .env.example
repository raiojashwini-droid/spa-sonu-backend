# OMEGA SPA POS Backend — Environment Variables
# Copy this file to .env and fill in your values

PORT=5000
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/omega_spa"
JWT_SECRET=your-secure-jwt-secret-at-least-16-chars
NODE_ENV=development

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta Social Media Automation (Facebook Page & Instagram Business)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=
TIKTOK_BUSINESS_ID=

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,https://omega-spa-pos.netlify.app
